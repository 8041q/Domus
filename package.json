{
  "name": "room-planner-prototype",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/optimize-models.mjs --optional",
    "dev": "node node_modules/vite/bin/vite.js",
    "prebuild": "node scripts/optimize-models.mjs --optional",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "models:rescan": "node scripts/rescan-models.mjs",
    "models:optimize": "node scripts/optimize-models.mjs",
    "models:benchmark": "node scripts/benchmark-models.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.app.json --incremental false && tsc -p tsconfig.node.json --incremental false --composite false",
    "start": "node server-dist/index.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  }
}
